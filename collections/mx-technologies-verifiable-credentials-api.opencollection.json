{
  "opencollection": "1.0.0",
  "info": {
    "name": "MX Platform accounts verifiable credentials API",
    "version": "20111101"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "verifiable credentials",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Identity Data",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://int-api.mx.com/vc/users/:user_guid/members/:member_guid/customers",
            "params": [
              {
                "name": "user_guid",
                "value": "USR-fa7537f3-48aa-a683-a02a-b18940482f54",
                "type": "path",
                "description": "The unique identifier for a `user`, beginning with the prefix `USR-`."
              },
              {
                "name": "member_guid",
                "value": "MBR-7c6f361b-e582-15b6-60c0-358f12466b4b",
                "type": "path",
                "description": "The unique id for a `member`."
              }
            ]
          },
          "docs": "Get an MX-issued verifiable credential of a user's identity data."
        },
        {
          "info": {
            "name": "Get Accounts Data",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://int-api.mx.com/vc/users/:user_guid/members/:member_guid/accounts",
            "params": [
              {
                "name": "user_guid",
                "value": "USR-fa7537f3-48aa-a683-a02a-b18940482f54",
                "type": "path",
                "description": "The unique identifier for a `user`, beginning with the prefix `USR-`."
              },
              {
                "name": "member_guid",
                "value": "MBR-7c6f361b-e582-15b6-60c0-358f12466b4b",
                "type": "path",
                "description": "The unique id for a `member`."
              }
            ]
          },
          "docs": "Get an MX-issued verifiable credential of a user's accounts data."
        },
        {
          "info": {
            "name": "Get Transactions Data",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://int-api.mx.com/vc/users/:user_guid/accounts/:account_guid/transactions",
            "params": [
              {
                "name": "user_guid",
                "value": "USR-fa7537f3-48aa-a683-a02a-b18940482f54",
                "type": "path",
                "description": "The unique identifier for a `user`, beginning with the prefix `USR-`."
              },
              {
                "name": "account_guid",
                "value": "ACT-06d7f44b-caae-0f6e-1384-01f52e75dcb1",
                "type": "path",
                "description": "The unique id for an `account`."
              },
              {
                "name": "startTime",
                "value": "2015-09-20",
                "type": "query",
                "description": "Filter transactions from this date. Must be in the format YYYY-MM-DD. The range is limited to 1 year."
              },
              {
                "name": "endTime",
                "value": "2015-09-20",
                "type": "query",
                "description": "Filter transactions to this date. Must be in the format YYYY-MM-DD. The range is limited to 1 year."
              }
            ]
          },
          "docs": "Get an MX-issued verifiable credential of a user's transaction data."
        }
      ]
    }
  ],
  "bundled": true
}