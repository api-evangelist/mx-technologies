{
  "opencollection": "1.0.0",
  "info": {
    "name": "MX Platform accounts goals API",
    "version": "20111101"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "goals",
